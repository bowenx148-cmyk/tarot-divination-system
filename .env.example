# ======================================================================
# indigo-tarot 环境变量示例
# 复制本文件为 .env.local（本地开发）或配置到服务器（生产，见 docs/DEPLOYMENT.md）
# 参考 docs/DEPLOYMENT.md
# ======================================================================

# ===== 系统 AI Key（可选；也可通过本机开发者后台配置）=====
# 系统 Key：免费试用与每日熔断配额的资金来源
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# 接口固定为对应提供商官方地址；模型在网页设置中选择。
# 后台配置加密保存在 .local；请持久保留 auth.json 与 settings.json。

# ===== 每日熔断配额（可选，默认 50）=====
# 系统 Key 每天（自然日，Asia/Shanghai 0 点起算）最多调用次数
QUOTA_DAILY_LIMIT=50

# ===== 开发者后台（可选；留空则不启用新部署的开发者登录）=====
DEVELOPER_USERNAME=
# 仅首次创建auth.json时使用；至少12字符。已有密码哈希不会被环境变量覆盖。
DEVELOPER_PASSWORD=
# 私有持久化目录；留空使用项目根目录.local，不能随仓库分享。
TAROT_DATA_DIR=

# ===== 管理统计/配额接口认证（使用这些管理接口时必填）=====
# 用于调用 /api/admin/quota 开关接口；生成方式：openssl rand -hex 16
# 生产环境务必重新生成，不要复用本地/示例值
ADMIN_TOKEN=

# ===== Redis（可选；本机单实例演示无需安装）=====
# 原试用缓存、限流、配额计数及聚合统计可用Redis；未配置时这些层回退内存。
# 额外的.local/trial-ledger.json持久化设备/账号试用及每日硬限额，正常重启不会清零。
# Redis不能替代当前账号/配置JSON文件，也不能使本项目自动成为多实例系统。
# 自建方式：apt install redis-server，设置 requirepass + appendonly yes（见 docs/archive/migration-2026-09.md §4.4）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
